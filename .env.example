# Copy this file to .env and fill in values locally.
# Never put real keys in this file. Never commit .env.

# LLM provider: fake (no network) or openai_compatible (OpenAI, Groq, Ollama, ...)
JARVIS_LLM_PROVIDER=fake
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_MODEL=gpt-4o-mini
JARVIS_LLM_TIMEOUT_SECONDS=60

# Groq example (do this in your local .env, then paste the key there only):
# JARVIS_LLM_PROVIDER=openai_compatible
# JARVIS_LLM_API_KEY=
# JARVIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# JARVIS_LLM_MODEL=openai/gpt-oss-120b
# Faster/cheaper: openai/gpt-oss-20b

# Write a rolling summary into memories.CONVERSATION_CONTEXT every N chat
# messages (user + assistant). Minimum 2. Default 10.
JARVIS_SUMMARY_EVERY=10

# Email. Default fake = no network (good for tests). For a real inbox:
# JARVIS_EMAIL_BACKEND=imap
# JARVIS_EMAIL_ADDRESS=you@gmail.com
# JARVIS_EMAIL_PASSWORD=app-password-not-login-password
# Never put a real password in this file. Send is always confirmation-gated.
JARVIS_EMAIL_BACKEND=fake
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_IMAP_HOST=imap.gmail.com
JARVIS_EMAIL_IMAP_PORT=993
JARVIS_EMAIL_SMTP_HOST=smtp.gmail.com
JARVIS_EMAIL_SMTP_PORT=587

# Morning news uses public RSS (Google News India + World + topics). No extra key.
# JARVIS_NEWS_NATIONAL_FEED=https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en
# JARVIS_NEWS_WORLD_FEED=https://news.google.com/rss/headlines/section/topic/WORLD?hl=en-IN&gl=IN&ceid=IN:en
# JARVIS_NEWS_PER_SECTION=6

# GitHub read-only. Default fake = canned repos/issues/PRs, no network.
# For live data set JARVIS_GITHUB_BACKEND=api and a read-only token in your
# local .env only — never paste the token in chat.
JARVIS_GITHUB_BACKEND=fake
JARVIS_GITHUB_TOKEN=

# SQLite file. Relative paths are resolved from the repo root.
# Leave unset to use data/jarvis.db
# JARVIS_DATABASE_PATH=data/jarvis.db
