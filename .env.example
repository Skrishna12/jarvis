# Copy this file to .env and fill in values locally.
# Never put real keys in this file. Never commit .env.

# LLM provider: fake (no network) or openai_compatible (OpenAI, Groq, Ollama, ...)
JARVIS_LLM_PROVIDER=fake
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_MODEL=gpt-4o-mini
JARVIS_LLM_TIMEOUT_SECONDS=60

# SQLite file. Relative paths are resolved from the repo root.
# Leave unset to use data/jarvis.db
# JARVIS_DATABASE_PATH=data/jarvis.db
